#!/usr/bin/env bash
# kubectl plan — the read-only counterpart to `kubectl up`. Renders an app with
# `kubectl build` and shows what an `up` would change. Name, namespace and the
# server-side flag come from kustomization.yaml exactly like `up`/`down`.
#
# Two passes, merged into one report:
#   1. Create/update — `kubectl diff` (server-side dry-run) of the built set,
#      stamped with the applyset.kubernetes.io/part-of label that `up` adds, or
#      every member diffs as losing it.
#   2. Prune (deletions) — `up`'s own apply with --dry-run=server, so kubectl's
#      applyset prune decides what goes rather than a copy of its logic. The
#      parent update and the deletes are server dry-runs too; nothing persists.
#      kubectl prunes only once every object applies, so when `up` would fail
#      the error is the report.
#
# Exit status: like `terraform plan`, a plan that runs cleanly exits 0 whether or
# not it found changes — drift is a successful plan, not a failure. Only a real
# error (bad build, unreachable cluster, etc.) exits non-zero. Pass
# --detailed-exitcode for the terraform-style code: 0 = no changes, 1 = changes
# (update and/or prune), 2 = error. Pass --no-prune to skip pass 2. Set
# KUBECTL_EXTERNAL_DIFF (e.g. "dyff between --omit-header") for a nicer diff.
set -e

EXTRA_ARGS=()
APP_KUSTOMIZE=false
APP_NAME=""
APP_NAMESPACE=""
SERVER_SIDE=false
USE_APPLYSET=true
PRUNE=true
DETAILED_EXITCODE=false
APP_DIR="${1}"
APP_INFILE="$APP_DIR"
shift

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) APP_NAME="$2"; shift 2 ;;
    --namespace) APP_NAMESPACE="$2"; shift 2 ;;
    --applyset) APP_NAME="$2"; shift 2 ;;
    --no-prune) PRUNE=false; shift ;;
    --detailed-exitcode) DETAILED_EXITCODE=true; shift ;;
    *) EXTRA_ARGS+=("$1"); shift ;;
  esac
done

if [ -f "${APP_DIR}/kustomization.yaml" ]; then
  APP_KUSTOMIZE=true
  APP_INFILE="-"
  readarray -t app_vals < <(yq -r '.metadata.name, .namespace // .metadata.namespace, (.metadata.annotations."kubectl.kubernetes.io/server-side" // "false"), (.metadata.annotations."kubectl.kubernetes.io/apply-set" // "true")' "${APP_DIR}/kustomization.yaml")
  APP_NAME=${APP_NAME:-"${app_vals[0]}"}
  APP_NAMESPACE=${APP_NAMESPACE:-"${app_vals[1]}"}
  SERVER_SIDE="${app_vals[2]}"
  USE_APPLYSET="${app_vals[3]}"
fi

APPLYSET=false
[ "${USE_APPLYSET}" = "true" ] && [ -n "${APP_NAME}" ] && APPLYSET=true

# Render once so both passes read the same set.
BUILT="$(mktemp)"
STAMPED="$(mktemp)"
trap 'rm -f "$BUILT" "$STAMPED"' EXIT
if [ "${APP_KUSTOMIZE}" = true ]; then
  kubectl build "${APP_DIR}" > "$BUILT"
else
  cp "${APP_DIR}" "$BUILT"
fi

# --- Pass 1: create/update -------------------------------------------------
# kubectl derives the id from the parent Secret alone, so it is known before
# the first `up`: base64url(sha256("<name>.<namespace>.Secret.")).
cp "$BUILT" "$STAMPED"
if [ "${APPLYSET}" = true ]; then
  hex="$(printf '%s.%s.Secret.' "${APP_NAME}" "${APP_NAMESPACE}" | sha256sum)"
  APPLYSET_ID="applyset-$(printf "$(sed 's/../\\x&/g' <<<"${hex%% *}")" | base64 | tr '+/' '-_' | tr -d '=\n')-v1"
  APPLYSET_ID="${APPLYSET_ID}" yq -i 'with(select(.kind); .metadata.labels."applyset.kubernetes.io/part-of" = strenv(APPLYSET_ID))' "$STAMPED"
fi

# Like `up`, --namespace only rides with --applyset; a multi-namespace app
# without one would fail the namespace check.
DIFF_ARGS=(-f "$STAMPED")
[ "${APPLYSET}" = true ] && DIFF_ARGS+=(--namespace "${APP_NAMESPACE}")
[ "${SERVER_SIDE}" = "true" ] && DIFF_ARGS+=(--server-side)

set +e
kubectl diff "${DIFF_ARGS[@]}" "${EXTRA_ARGS[@]}"
DIFF_RC=$?
set -e
[ "$DIFF_RC" -gt 1 ] && exit 2   # real error, not just "changes found"

# --- Pass 2: prune (up's apply, server dry-run) ----------------------------
# The unstamped build: kubectl refuses input that already carries the label.
PRUNE_RC=0
if [ "${PRUNE}" = true ] && [ "${APPLYSET}" = true ]; then
  APPLY_ARGS=(-f "$BUILT" --dry-run=server --prune --applyset "${APP_NAME}" --namespace "${APP_NAMESPACE}")
  [ "${SERVER_SIDE}" = "true" ] && APPLY_ARGS+=(--server-side)

  set +e
  APPLY_OUT="$(kubectl apply "${APPLY_ARGS[@]}" "${EXTRA_ARGS[@]}" 2>&1)"
  APPLY_RC=$?
  set -e
  if [ "$APPLY_RC" -ne 0 ]; then
    echo >&2
    echo "# Prune — not previewed, up would fail before pruning:" >&2
    grep -v ' (server dry run)$' <<<"$APPLY_OUT" >&2
    exit 2
  fi

  readarray -t PRUNES < <(sed -n 's/ pruned (server dry run)$//p' <<<"$APPLY_OUT")
  if [ "${#PRUNES[@]}" -gt 0 ]; then
    PRUNE_RC=1
    echo
    echo "# Prune — live applyset members not in the build (would be deleted by up):"
    printf '  - %s\n' "${PRUNES[@]}"
  fi
fi

# A clean run is a success (exit 0), even with changes — unless the caller opts
# into terraform-style detailed codes, where 1 signals "changes found".
if [ "${DETAILED_EXITCODE}" = true ] && { [ "$DIFF_RC" -eq 1 ] || [ "$PRUNE_RC" -eq 1 ]; }; then
  exit 1
fi
exit 0
